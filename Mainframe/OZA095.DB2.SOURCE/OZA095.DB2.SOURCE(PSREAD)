                 INSERT INTO EMPLOYEE_TABLE (EMPLOYEE_NO,               00300000
                                             EMPLOYEE_NAME,
                                             EMPLOYEE_DEPT,
                                             EMPLOYEE_LOCATION,
                                             EMPLOYEE_SALARY)
                 VALUES (:EMPLOYEE-NO,                                  00310004
                         :EMPLOYEE-NAME,
                         :EMPLOYEE-DEPT,
                         :EMPLOYEE-LOCATION,
                         :EMPLOYEE-SALARY)
